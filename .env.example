# Supabase → Project Settings → Database
# Transaction pooler, port 6543. The API will use this later.
DATABASE_URL=

# Direct connection, port 5432. Prisma Migrate needs this one.
DIRECT_URL=

# Supabase → Project Settings → API
SUPABASE_URL=https://oyvfcgnpfnvbqmxbkzkv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Fastify. The site reads services and barbers from this API.
API_PORT=4000
API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000

# BotFather → token and the bot username without @.
# API_PUBLIC_URL is the HTTPS address Telegram calls. Localhost cannot receive the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
API_PUBLIC_URL=
APP_URL=http://localhost:3000
MINIAPP_URL=

# Secret for Supabase Cron and POST /internal/notifications. The edge function also accepts the service role.
CRON_SECRET=

# First owner is created on API start when both values are set and the login does not exist yet.
ADMIN_LOGIN=owner
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=
